# Authentication mode: default, interactive, or client_secret
FABRIC_AUTH_MODE=default

# Required only for client_secret mode. Never commit real values.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Optional service endpoint overrides
FABRIC_API_BASE_URL=https://api.fabric.microsoft.com
POWER_BI_API_BASE_URL=https://api.powerbi.com

# Optional HTTP behavior
FABRIC_API_TIMEOUT_SECONDS=30
FABRIC_API_MAX_RETRIES=4

